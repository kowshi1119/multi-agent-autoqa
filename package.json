{
  "name": "autoqa",
  "version": "0.1.0",
  "description": "AutoQA Phase 1 - autonomous QA exploration engine",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "provider:check": "tsx src/provider-check.ts",
    "local-explorer:benchmark": "tsx src/experiments/local-explorer-benchmark.ts",
    "qa": "tsc && node dist/src/index.js",
    "qa:debug": "tsc && cross-env DEBUG=pw:api node dist/src/index.js",
    "benchmark": "tsc && node dist/src/benchmark.js",
    "experiment:phase2": "tsc && node dist/src/phase2-experiment.js",
    "experiment:phase3": "tsc && node dist/src/phase3-experiment.js",
    "challenge-corpus:validate": "tsc && node dist/src/experiments/challenge-corpus-validate.js",
    "human-review:export": "tsc && node dist/src/human-review/export-cli.js",
    "human-review:import": "tsc && node dist/src/human-review/import-cli.js",
    "doctor": "tsc && node dist/src/preflight/doctor-cli.js",
    "ui": "tsc && node scripts/copy-public-assets.mjs && node dist/src/server/app-cli.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/genai": "2.23.0",
    "dotenv": "^16.4.5",
    "openai": "^4.104.0",
    "pino": "^9.5.0",
    "playwright": "^1.48.2",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
