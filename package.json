{
  "name": "autoqa",
  "version": "0.1.0",
  "description": "AutoQA Phase 0 - autonomous QA agent prototype",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qa": "tsc && node dist/src/index.js",
    "qa:debug": "tsc && cross-env DEBUG=pw:api node dist/src/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "playwright": "^1.48.2",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
